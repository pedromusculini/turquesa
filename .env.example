# Turquesa Agenda — environment template (no secrets; copy to .env.local)
# Supabase local: docs/SUPABASE_LOCAL.md | bypass UI: docs/DEV_LOCAL.md

# App URL (local dev; production canonical: https://www.turquesaagenda.com.br)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Meta Pixel (Facebook Ads) — opcional; padrão em lib/metaPixel.ts se omitido
# NEXT_PUBLIC_META_PIXEL_ID=2631118973956450

# GA4 + Microsoft Clarity — só carregam após consentimento no banner
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
# Personal access token (Account → Access Tokens) — só scripts npm run db:*
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token

# Email (Resend) — https://resend.com — domínio turquesaagenda.com.br verificado
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Turquesa Agenda <naoresponda@turquesaagenda.com.br>

# Google OAuth — https://console.cloud.google.com (opcional com DEV_BYPASS_AUTH)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Aliases aceitos em auth.ts: AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET

# NextAuth / Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
AUTH_SECRET=change-me

# WhatsApp Business (Meta Cloud API) — see docs/WHATSAPP_BUSINESS_SETUP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
CRON_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_FORMULARIO_LINK=
WHATSAPP_TEMPLATE_LEMBRETE_CONSULTA=
WHATSAPP_TEMPLATE_FORMULARIO_RECEBIDO=
WHATSAPP_TEMPLATE_CONFIRMACAO_PAGAMENTO=

# Internal ops (server-only; never NEXT_PUBLIC_; do not commit real emails)
ADMIN_EMAILS=admin@example.com
# Opcional: curl detalhado em prod — header x-health-config-secret
# HEALTH_CONFIG_SECRET=openssl-rand-hex-32
INTERNAL_PRODUCT_ID=turquesa-agenda
# INTERNAL_ADMIN_SOLO=false  # só dev — em produção ignora outros e-mails da lista
# INTERNAL_ADMIN_SOLO_EMAIL=pedromusculini@gmail.com

# Financeiro — parse legacy de observações em catálogo (conta com import CSV antigo; vazio = desligado)
# FINANCEIRO_LEGACY_CATALOGO_OWNER=conta@exemplo.com

# Asaas — ver docs/ASAAS_BILLING.md (sandbox ou produção)
# ASAAS_API_KEY=
# ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# ASAAS_WEBHOOK_TOKEN=   # token do painel Webhooks (não é ASAAS_API_KEY)
# ASAAS_BILLING_ENFORCED=false   # local: false; Vercel Production: true

# Dev local — ver docs/DEV_LOCAL.md (NUNCA true em Vercel Production)
# DEV_BYPASS_AUTH=false
# DEV_LOCAL_COMPILED=false   # true só para npm run start:local após build
# ALLOW_DEV_BYPASS_COMPILED=false   # alias de DEV_LOCAL_COMPILED
# DEV_BYPASS_EMAIL=
# DEV_BYPASS_GOOGLE_SUB=
# DEV_BYPASS_NAME=
# DEV_BYPASS_USER_ID=
# DEV_BYPASS_PLAN=ilimitado
# DEV_BYPASS_USER_TYPE=clinica   # clinica | medico — padrão clinica (profissionais no catálogo)
